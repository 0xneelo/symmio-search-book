# Dependencies
node_modules/

# Secrets / environment (LLM key loaded only via node --env-file)
.env
.env.*
!.env.example
.secrets/

# Answer-engine SQLite datastore + WAL/journal sidecars + backups
*.sqlite
*.sqlite-*
*.db
*.db-*
search-book-answer-engine*.sqlite
search-book-answer-engine*.db
backups/

# Raw local Discord exports; checked-in data must remain no-raw/internal-only.
.discord-export/
raw-discord-exports/

# Logs / OS noise
*.log
.DS_Store

# Vite build output (field-manual-v2 web app)
web/dist/
web/node_modules/.tmp/
web/test-results/
web/playwright-report/

# local agent scratch (session reports, worklogs, runtime DBs/logs) — never track
_local/
